{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prismatic",
  "version": "2.0.0",
  "identifier": "app.prismatic.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:4100",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Prismatic 2.0",
        "width": 1440,
        "height": 900,
        "minWidth": 840,
        "minHeight": 600,
        "backgroundColor": "#080b11",
        "dataDirectory": "webview-v2",
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost http://localhost:* ws://localhost:*; img-src 'self' asset: http://asset.localhost blob: data:; media-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; worker-src 'self' blob:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/Music/Prismatic/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "../build/icon.ico",
      "../build/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "../build/icon.ico",
        "headerImage": null,
        "sidebarImage": null,
        "displayLanguageSelector": false,
        "languages": ["English"]
      }
    }
  }
}
