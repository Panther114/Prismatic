{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prismatic",
  "mainBinaryName": "Prismatic",
  "version": "2.1.6",
  "identifier": "app.prismatic.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:4100",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Prismatic 2.1",
        "width": 1440,
        "height": 900,
        "minWidth": 840,
        "minHeight": 600,
        "backgroundColor": "#080b11",
        "dataDirectory": "webview-v2",
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset: http://asset.localhost https://asset.localhost; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost http://localhost:* ws://localhost:* http://asset.localhost https://asset.localhost asset: https://prismatic.up.railway.app https://*.up.railway.app https://*.railway.app https://github.com https://*.github.com https://objects.githubusercontent.com https://release-assets.githubusercontent.com; img-src 'self' asset: http://asset.localhost https://asset.localhost blob: data:; media-src 'self' asset: http://asset.localhost https://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; worker-src 'self' blob:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/Music/Prismatic/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Prismatic",
    "copyright": "Prismatic",
    "icon": [
      "../build/icon.ico",
      "../build/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "../build/icon.ico",
        "headerImage": null,
        "sidebarImage": null,
        "displayLanguageSelector": false,
        "languages": ["English"],
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM1MDMxM0U4RThGMTM1QkIKUldTN05mSG82Qk1EeGZib05wNC92MUdEN2RhZUtJejA0M28yZ1ZHS2M2RWhkRmlrVksrWWdXbnMK",
      "endpoints": [
        "https://github.com/Panther114/Prismatic/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
