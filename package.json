{
  "name": "prismatic",
  "version": "2.1.0",
  "private": true,
  "author": "Prismatic",
  "description": "Prismatic — cinematic music visualizer & player. Browser-side export keeps the host lightweight.",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "start": "cross-env NODE_ENV=production node dist-server/index.mjs",
    "start:ts": "cross-env NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm build && pnpm build:server",
    "test": "vitest run",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "pnpm test && pnpm check && tauri build --bundles nsis",
    "dist:win": "pnpm tauri:build && node scripts/verify-tauri-installer.mjs",
    "prepare:sample": "tsx scripts/prepare-sample.ts",
    "render:sample": "tsx scripts/render-sample.ts",
    "verify:installer": "node scripts/verify-tauri-installer.mjs"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.2.8",
    "@fontsource/ibm-plex-sans": "^5.2.7",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "cross-env": "^7.0.3",
    "express": "^5.1.0",
    "fft.js": "^4.0.4",
    "lucide-react": "^0.525.0",
    "multer": "^2.0.2",
    "music-metadata": "^11.8.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.14",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "@tauri-apps/cli": "^2.11.3",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "vite": "^7.0.5"
  }
}
